{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CitationNetwork",
  "type": "object",
  "required": ["mode", "nodes", "edges", "seed_ids", "stopping_rule", "systematic_completeness", "limitations"],
  "properties": {
    "mode": {"const": "citation-network-exploration"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "retrieved_at", "access_state", "screening_decision", "publication_status_check", "discovery_routes", "evidence_level", "classification_confidence", "classification_reason", "citation_count_use"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": "string", "minLength": 1},
          "access_state": {"type": "string", "minLength": 1},
          "screening_decision": {"enum": ["include", "exclude", "unresolved"]},
          "publication_status_check": {
            "type": "object",
            "required": ["status", "source", "checked_at"],
            "properties": {
              "status": {"enum": ["clear", "corrected", "expression-of-concern", "retracted", "unresolved"]},
              "source": {"type": "string", "minLength": 1},
              "checked_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
            }
          },
          "content_evidence": {
            "type": "object",
            "required": ["type", "artifact_id", "artifact_hash", "source_locator", "verification_status"],
            "properties": {
              "type": {"enum": ["abstract", "full-text"]},
              "artifact_id": {"type": "string", "minLength": 1},
              "artifact_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
              "source_locator": {"type": "string", "pattern": "^[^:]+:.+$"},
              "verification_status": {"const": "VERIFIED"}
            }
          },
          "discovery_routes": {"type": "array", "minItems": 1},
          "evidence_level": {"type": "string"},
          "classification_confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "classification_reason": {"type": "string"},
          "citation_count_use": {"const": "DESCRIPTIVE_ONLY"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "type", "verification_status", "source_system", "retrieved_at", "request_id"],
        "properties": {
          "type": {"enum": ["cites", "cited_by", "updates", "corrects", "retracts", "related_by_source"]},
          "verification_status": {"const": "VERIFIED"}
        }
      }
    },
    "seed_ids": {"type": "array", "minItems": 1},
    "stopping_rule": {
      "type": "object",
      "required": ["type", "prespecified"],
      "properties": {
        "type": {"enum": ["two_rounds_no_new_eligible", "date_cutoff", "all_key_papers_chased", "resource_limit"]},
        "prespecified": {"const": true}
      }
    },
    "systematic_completeness": {"const": false},
    "limitations": {"type": "array", "minItems": 1}
  },
  "additionalProperties": false
}
