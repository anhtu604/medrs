{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MedRS local project workspace",
  "type": "object",
  "required": ["schema_version", "project_id", "status", "final", "last_event"],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "project_id": {"type": "string", "minLength": 1},
    "status": {"type": "string"},
    "final": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "date", "round"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "date": {"type": "string", "format": "date"},
          "round": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "last_event": {"type": ["object", "null"]},
    "understanding": {
      "type": "object",
      "required": ["status", "parts", "open_items", "confirmed_on", "confirmation"],
      "properties": {
        "status": {"enum": ["NOT_STARTED", "IN_PROGRESS", "DEFERRED_BY_AUTHOR", "CONFIRMED"]},
        "parts": {
          "type": "object",
          "required": ["background", "question", "methods", "expected"],
          "additionalProperties": {"enum": ["NOT_STARTED", "EXPLAINED", "CHECKED_BACK", "DONE"]},
          "propertyNames": {"enum": ["background", "question", "methods", "expected"]}
        },
        "open_items": {"type": "integer", "minimum": 0},
        "confirmed_on": {"type": ["string", "null"], "format": "date"},
        "confirmation": {"type": ["string", "null"]},
        "locale": {"enum": ["vi", "en"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
